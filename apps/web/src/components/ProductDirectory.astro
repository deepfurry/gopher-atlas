---
import {
  editorialView,
  contentPath,
  hasEnglish,
} from '../lib/publication/editorial';
import * as stylex from '@stylexjs/stylex';
import { products as s } from '../styles/products.stylex';
import PageHero from './PageHero.astro';
import { words, localized, type Locale } from '../lib/i18n';
import type { Publication } from '../lib/publication/indexes';
import NoteGroupCard from './NoteGroupCard.astro';
import Icon from './Icon.astro';
interface Props {
  kind: 'topics' | 'notes';
  publication: Publication;
  locale?: Locale;
}
const { kind, publication: p, locale = 'zh' } = Astro.props,
  t = words[locale],
  topics = p.contentByType
    .get('topic')!
    .map((item) => editorialView(item, locale));
---

<PageHero
  label={kind === 'topics' ? '03 / TOPICS' : '01 / FIELD NOTES'}
  title={t[kind]}
  description={kind === 'topics' ? t.topicsIntro : t.notesIntro}
/>
<section aria-label={t[kind]}>
  {
    kind === 'topics'
      ? topics.map((topic, index) => (
          <article {...stylex.attrs(s.topicRow)} lang={topic.language}>
            <span {...stylex.attrs(s.number)}>
              {String(index + 1).padStart(2, '0')}
            </span>
            <div>
              <h2 {...stylex.attrs(s.topicTitle)}>
                <a href={contentPath(topic, locale)}>{topic.title}</a>
              </h2>
              <p {...stylex.attrs(s.summary)}>{topic.summary}</p>
              {locale === 'en' && !hasEnglish(topic) && (
                <p class="small-meta">Original language: {topic.language}</p>
              )}
              <p {...stylex.attrs(s.meta)}>
                {topic.topicEntries.length} {t.articleCount}
              </p>
            </div>
            <a
              href={contentPath(topic, locale)}
              aria-label={t.enterTopic + ': ' + topic.title}
            >
              <Icon name="arrowUpRight" />
            </a>
          </article>
        ))
      : p.groups.map((group, index) => (
          <NoteGroupCard
            group={group}
            publication={p}
            locale={locale}
            order={index}
          />
        ))
  }
  {
    !(kind === 'topics' ? topics.length : p.groups.length) && (
      <p class="empty">
        {t.noPublicContent}{' '}
        <a href={localized('/articles/', locale)}>{t.browse}</a>
      </p>
    )
  }
</section>
