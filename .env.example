# Local development. Process environment takes precedence over make dev-cms .env loading.
APP_ENV=development
CMS_LISTEN_ADDR=127.0.0.1:46217
CMS_BASE_URL=http://127.0.0.1:5173
DATABASE_PATH=./data/gopheratlas.db

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Local OAuth example: http://127.0.0.1:5173/api/auth/github/callback
# Production: https://blog.go-furry.com/api/auth/github/callback
GITHUB_OAUTH_REDIRECT_URI=
BOOTSTRAP_ADMIN_GITHUB_ID=

SESSION_TTL=168h
OAUTH_STATE_TTL=10m

# P0-4: leave ALL eight values empty for offline development. Partial configuration fails.
# Production requires all eight; Web builds use a separate read-only credential.
# Staging: buckets gopheratlas-assets / gopheratlas-content; asset origin https://assets.gopheratlas.com.
# PUBLIC_SITE_URL is the staging Worker origin until separately approved cutover.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ASSETS_BUCKET=
R2_CONTENT_BUCKET=
R2_ASSETS_PUBLIC_URL=
CLOUDFLARE_DEPLOY_HOOK_URL=
PUBLIC_SITE_URL=

# Web BUILD process only, not CMS. No PUBLIC_/VITE_ credentials.
# Local/check explicitly selects tests/fixtures/content-snapshot-v1.json.
CONTENT_R2_ENDPOINT=
CONTENT_R2_BUCKET=
CONTENT_R2_ACCESS_KEY_ID=
CONTENT_R2_SECRET_ACCESS_KEY=
CONTENT_SNAPSHOT_FILE=

LOG_LEVEL=info
LOG_FILE=./logs/cms.jsonl
LOG_MAX_SIZE_MB=100
LOG_MAX_BACKUPS=10
LOG_MAX_AGE_DAYS=30
LOG_COMPRESS=true
