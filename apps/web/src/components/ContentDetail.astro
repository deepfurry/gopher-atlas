---
import Layout from '../layouts/Layout.astro';
import MarkdownBody from './MarkdownBody.astro';
import SourceMeta from './SourceMeta.astro';
import TopicBody from './TopicBody.astro';
import Discussion from './Discussion.astro';
import {
  dateLabel,
  required,
  seo,
  typeInfo,
  type Publication,
} from '../lib/publication/indexes';
import { renderMarkdown } from '../lib/publication/markdown';
import type { Content } from '../lib/publication/types';
interface Props {
  content: Content;
  publication: Publication;
  preview?: {
    updatedAt: number;
    entries: { position: number; title: string; content?: Content }[];
  };
}
const { content: item, publication: p, preview } = Astro.props;
const author = required(p.authorById, item.authorId),
  cover =
    item.coverAssetId === null
      ? undefined
      : required(p.assetById, item.coverAssetId);
const tags = item.tagIds.map((id) => required(p.tagById, id)),
  rendered = await renderMarkdown(item.bodyMarkdown);
const headings = rendered.metadata.headings.filter(
    (h) => h.depth === 2 || h.depth === 3,
  ),
  info = typeInfo[item.type];
const group =
  item.type === 'note' ? p.notesByGroup.get(item.payload.groupSlug) : undefined;
const index = group?.content.findIndex((note) => note.id === item.id) ?? -1;
const previous = index > 0 ? group?.content[index - 1] : undefined,
  next = index >= 0 ? group?.content[index + 1] : undefined;
const authorHeading =
  item.type === 'curated_article' ? '关于策展者' : '关于作者';
const bylineLabel =
  item.type === 'curated_article'
    ? `策展：${author.displayName}`
    : author.displayName;
---

<Layout
  {...seo(item)}
  canonical={item.canonicalPath}
  lang={item.language}
  image={cover?.url}
  ogType={item.type === 'topic' ? 'website' : 'article'}
  searchIndex={!preview && item.type !== 'post'}
  noindex={Boolean(preview)}
>
  {
    preview && (
      <p class="notice" role="status">
        本地草稿预览，不会发布内容。
      </p>
    )
  }
  {
    item.type === 'topic' ? (
      <TopicBody item={item} publication={p} entries={preview?.entries} />
    ) : (
      <div class:list={{ 'reading-layout': item.type === 'note' }}>
        <article class="prose content-detail">
          <header>
            <nav class="breadcrumb" aria-label="内容位置" data-pagefind-ignore>
              <a href={info.path}>{info.title}</a>
              {item.type === 'note' && (
                <a href={`/notes/${item.payload.groupSlug}/`}>
                  {item.payload.group}
                </a>
              )}
            </nav>
            <h1 data-pagefind-meta="title">
              {item.type === 'curated_article' ? (
                <a
                  href={item.payload.sourceUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {item.title}
                </a>
              ) : (
                item.title
              )}
            </h1>
            {item.summary && <p class="lede">{item.summary}</p>}
            <div class="publication-meta">
              <a
                href={`/authors/${author.slug}/`}
                rel="author"
                data-pagefind-meta="author"
              >
                {bylineLabel}
              </a>
              <span>
                {preview
                  ? '草稿保存于'
                  : item.type === 'curated_article'
                    ? '收录于'
                    : '创建于'}{' '}
                <time
                  datetime={new Date(
                    preview?.updatedAt ?? item.firstPublishedAt,
                  ).toISOString()}
                >
                  {dateLabel(preview?.updatedAt ?? item.firstPublishedAt)}
                </time>
              </span>
              {!preview && item.lastPublishedAt !== item.firstPublishedAt && (
                <span>
                  更新于{' '}
                  <time datetime={new Date(item.lastPublishedAt).toISOString()}>
                    {dateLabel(item.lastPublishedAt)}
                  </time>
                </span>
              )}
            </div>
            {tags.length > 0 && (
              <ul class="tag-list" aria-label="标签">
                {tags.map((tag) => (
                  <li>
                    <a class="chip" href={`/tags/${tag.slug}/`}>
                      {tag.name}
                    </a>
                  </li>
                ))}
              </ul>
            )}
          </header>
          {cover && (
            <img
              class="cover-image"
              src={cover.url}
              alt=""
              width={cover.width}
              height={cover.height}
              decoding="async"
              referrerpolicy="no-referrer"
            />
          )}
          {item.type === 'curated_article' && (
            <>
              <SourceMeta payload={item.payload} />
              <h2>收录理由 / 编辑点评</h2>
            </>
          )}
          {item.type === 'note' && headings.length > 0 && (
            <details class="mobile-toc" data-pagefind-ignore>
              <summary>本页目录</summary>
              <ul>
                {headings.map((h) => (
                  <li>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </details>
          )}
          <div class="markdown" set:html={rendered.code} />
          {item.type === 'note' && (
            <>
              <nav
                class="note-neighbors"
                aria-label="组内连续阅读"
                data-pagefind-ignore
              >
                <div>
                  {previous && (
                    <a href={previous.canonicalPath}>
                      <small>上一篇</small>
                      {previous.title}
                    </a>
                  )}
                </div>
                <div>
                  {next && (
                    <a href={next.canonicalPath}>
                      <small>下一篇</small>
                      {next.title}
                    </a>
                  )}
                </div>
              </nav>
              <a class="btn" href="/notes/">
                返回学习随笔
              </a>
              {!preview && (
                <Discussion
                  groupSlug={item.payload.groupSlug}
                  slug={item.slug}
                />
              )}
            </>
          )}
          <aside class="author-note" data-pagefind-ignore>
            <h2>{authorHeading}</h2>
            <a href={`/authors/${author.slug}/`}>{author.displayName}</a>
            {author.bioMarkdown && <MarkdownBody source={author.bioMarkdown} />}
          </aside>
        </article>
        {item.type === 'note' && headings.length > 0 && (
          <aside class="toc" data-pagefind-ignore>
            <nav aria-label="本页目录">
              <p>本页目录</p>
              <ul>
                {headings.map((h) => (
                  <li class:list={{ nested: h.depth === 3 }}>
                    <a href={`#${h.slug}`}>{h.text}</a>
                  </li>
                ))}
              </ul>
            </nav>
          </aside>
        )}
      </div>
    )
  }
</Layout>
