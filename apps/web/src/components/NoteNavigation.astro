---
import { taxonomyText } from '../lib/publication/taxonomy';
import * as stylex from '@stylexjs/stylex';
import { products as s } from '../styles/products.stylex';
import { layout as l } from '../styles/layout.stylex';
import { words, localized, type Locale } from '../lib/i18n';
import { type Publication } from '../lib/publication/indexes';
import type { Content } from '../lib/publication/types';
interface Props {
  item: Content;
  group?: Publication['groups'][number];
  locale: Locale;
}
const { item, group, locale } = Astro.props,
  t = words[locale];
const notes = group?.content ?? [],
  index = notes.findIndex((note) => note.id === item.id);
const previous = index >= 0 ? notes[index - 1] : undefined,
  next = index >= 0 ? notes[index + 1] : undefined;
---

<nav
  class:list={['note-navigation', stylex.attrs(s.neighbors).class]}
  aria-label={t.noteNavigation}
  data-pagefind-ignore
>
  <div {...stylex.attrs(s.neighborGrid)}>
    {
      previous && (
        <a href={localized(previous.canonicalPath, locale)} rel="prev">
          <>
            <small>{t.previousNote}</small>
            <strong>{previous.title}</strong>
          </>
        </a>
      )
    }
    {
      next && (
        <a href={localized(next.canonicalPath, locale)} rel="next">
          <>
            <small>{t.nextNote}</small>
            <strong>{next.title}</strong>
          </>
        </a>
      )
    }
  </div>
  <div {...stylex.attrs(s.links)}>
    {
      group && (
        <a
          {...stylex.attrs(l.textLink)}
          href={localized('/notes/' + group.slug + '/', locale)}
        >
          {taxonomyText(group, locale).name}
        </a>
      )
    }
    <a {...stylex.attrs(l.textLink)} href={localized('/notes/', locale)}
      >{t.back}</a
    >
  </div>
</nav>
