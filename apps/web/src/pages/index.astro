---
import Layout from '../layouts/Layout.astro';
import ContentList from '../components/ContentList.astro';
import { publication } from '../lib/publication/snapshot';
import { typeInfo } from '../lib/publication/indexes';
const types = ['curated_article', 'post', 'note', 'topic'] as const;
---

<Layout title="Go 知识地图">
  <header class="home-intro">
    <div>
      <h1>探索 Go，<br />连接知识与实践。</h1>
      <p class="lede">
        从一篇好文章到一次亲手实践。精选阅读、原创写作、工程笔记与知识专题，在这里相互连接。
      </p>
    </div>
    <nav class="atlas-nav" aria-label="内容方向">
      {
        types.map((type) => (
          <a href={typeInfo[type].path}>
            <>
              <strong>{typeInfo[type].title}</strong>
              <span>{typeInfo[type].description}</span>
            </>
          </a>
        ))
      }
    </nav>
  </header>
  {
    types.map((type) => (
      <section class="home-section" aria-labelledby={type}>
        <header>
          <>
            <h2 id={type}>
              <a href={typeInfo[type].path}>{typeInfo[type].title}</a>
            </h2>
            <p>{typeInfo[type].description}</p>
            <a href={typeInfo[type].path}>浏览全部{typeInfo[type].title}</a>
          </>
        </header>
        <ContentList
          items={publication.highlights(type)}
          publication={publication}
          heading="h3"
        />
      </section>
    ))
  }
</Layout>
