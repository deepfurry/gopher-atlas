---
import Layout from '../layouts/Layout.astro';
import { words, localized, type Locale } from '../lib/i18n';
import ContentList from './ContentList.astro';
import MarkdownBody from './MarkdownBody.astro';
import type { Publication } from '../lib/publication/indexes';
import type { CollectionPage } from '../lib/publication/routes';
interface Props {
  page: CollectionPage;
  publication: Publication;
  locale?: Locale;
}
const { page, publication, locale = 'zh' } = Astro.props;
const t = words[locale];
const { author } = page;
---

<Layout
  title={page.title + (page.page > 1 ? ` / ${page.page} ${t.page}` : '')}
  description={page.description}
  canonical={page.path}
  locale={locale}
>
  <div class="collection-layout">
    <header class="collection-heading">
      {
        author?.avatarUrl && (
          <img
            class="avatar"
            src={author.avatarUrl}
            alt=""
            width="72"
            height="72"
            loading="lazy"
            referrerpolicy="no-referrer"
          />
        )
      }
      <h1>{page.title}</h1><p class="lede">{page.description}</p>
      {
        author && (
          <>
            <MarkdownBody source={author.bioMarkdown} />
            {author.websiteUrl && (
              <a href={author.websiteUrl} rel="noopener noreferrer">
                {t.authorWebsite}
              </a>
            )}
          </>
        )
      }
      {page.tag && <a href={localized('/tags/', locale)}>{t.allTags}</a>}
      {
        author && (
          <p>
            <a href={localized('/authors/', locale)}>{t.allAuthors}</a>
          </p>
        )
      }
    </header>
    <div>
      <ContentList
        items={page.content}
        publication={publication}
        locale={locale}
      />
      {
        page.total > 1 && (
          <nav
            class="pagination"
            aria-label={locale === 'zh' ? '分页' : 'Pagination'}
          >
            {page.previous && (
              <a href={localized(page.previous, locale)} rel="prev">
                {t.previous}
              </a>
            )}
            <span>
              {page.page} / {page.total} {t.page}
            </span>
            {page.next && (
              <a href={localized(page.next, locale)} rel="next">
                {t.next}
              </a>
            )}
          </nav>
        )
      }
    </div>
  </div>
</Layout>
