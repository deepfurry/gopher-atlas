# P0-0 reads only CMS_LISTEN_ADDR. Other names reserve later-phase configuration.
CMS_LISTEN_ADDR=127.0.0.1:46217
CMS_BASE_URL=https://blog.go-furry.com
PUBLIC_SITE_URL=https://gopheratlas.com
DATABASE_PATH=./data/gopheratlas.db

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=https://blog.go-furry.com/api/auth/github/callback
BOOTSTRAP_ADMIN_GITHUB_ID=

R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ASSETS_BUCKET=gopheratlas-assets
R2_CONTENT_BUCKET=gopheratlas-content
R2_ASSETS_PUBLIC_URL=https://assets.gopheratlas.com
CLOUDFLARE_DEPLOY_HOOK_URL=

LOG_LEVEL=info
LOG_FILE=./logs/cms.jsonl
LOG_MAX_SIZE_MB=100
LOG_MAX_BACKUPS=10
LOG_MAX_AGE_DAYS=30
LOG_COMPRESS=true
