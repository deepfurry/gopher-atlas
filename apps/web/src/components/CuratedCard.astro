---
import { taxonomyText } from '../lib/publication/taxonomy';
import * as stylex from '@stylexjs/stylex';
import { products as s } from '../styles/products.stylex';
import { words, localized, type Locale } from '../lib/i18n';
import { type Publication } from '../lib/publication/indexes';
import type { Content } from '../lib/publication/types';
import Icon from './Icon.astro';
interface Props {
  item: Extract<Content, { type: 'curated_article' }>;
  publication: Publication;
  locale?: Locale;
  searchable?: boolean;
  order?: number;
  heading?: 'h2' | 'h3';
}
const {
  item,
  publication: p,
  locale = 'zh',
  searchable = false,
  heading: Heading = 'h2',
} = Astro.props;
const t = words[locale],
  source = item.payload;
const topics = (p.contentByType.get('topic') ?? []).filter((topic) =>
  topic.topicEntries.some((entry) => entry.targetContentId === item.id),
);
const tags = item.tagIds.map((id) => p.tagById.get(id)!);
// Search still includes editorial rationale, source authors, tags and topics even
// though the compact row now links to the full editorial detail.
const searchText = [
  item.title,
  item.summary,
  item.bodyMarkdown,
  source.sourceAuthor,
  source.sourceName,
  ...tags.flatMap((tag) => [tag.name, taxonomyText(tag, locale).name]),
  ...topics.map((topic) => topic.title),
].join(' ');
---

<article
  class:list={['article-card', stylex.attrs(s.row).class]}
  lang={item.language}
  data-article={searchable ? '' : undefined}
  data-id={item.id}
  data-search-text={searchable ? searchText : undefined}
  data-topics={JSON.stringify(topics.map((topic) => topic.slug))}
  data-tags={JSON.stringify(tags.map((tag) => tag.slug))}
  data-language={source.sourceLanguage}
  data-rating={source.rating}
  data-difficulty={source.difficulty}
  data-title={item.title}
  data-recommended={source.mustRead ? '1' : '0'}
  data-featured={item.featured ? '1' : '0'}
  data-added={item.firstPublishedAt}
  data-source-date={source.sourcePublishedAt}
>
  <div {...stylex.attrs(s.meta)}>
    <span>{source.sourceName || source.sourceAuthor}</span>
    <span
      >{
        source.sourceLanguage === 'zh'
          ? '中文'
          : source.sourceLanguage === 'en'
            ? 'English'
            : source.sourceLanguage
      }</span
    >
    {source.mustRead && <span>{t.mustRead}</span>}
    {item.featured && <span>{t.featured}</span>}
  </div>
  <span
    class:list={['rating', stylex.attrs(s.rating).class]}
    aria-label={t.rating + ' ' + source.rating}>{source.rating}</span
  >
  <Heading {...stylex.attrs(s.rowTitle)}>
    <a href={source.sourceUrl} target="_blank" rel="noopener noreferrer"
      >{item.title}</a
    >
  </Heading>
  {item.summary && <p {...stylex.attrs(s.summary)}>{item.summary}</p>}
  <div {...stylex.attrs(s.links)}>
    <a
      class="inline-link"
      href={source.sourceUrl}
      target="_blank"
      rel="noopener noreferrer"
      >{locale === 'zh' ? '阅读原文' : 'Read source'}
      <Icon name="arrowUpRight" /></a
    >
    <a class="inline-link" href={localized(item.canonicalPath, locale)}
      >{locale === 'zh' ? '查看点评' : 'Editorial notes'}
      <Icon name="arrowRight" /></a
    >
  </div>
</article>
