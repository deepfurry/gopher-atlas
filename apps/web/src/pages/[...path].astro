---
import { publication } from '../lib/publication/snapshot';
import { publicPages, type PublicPage } from '../lib/publication/routes';
import ContentDetail from '../components/ContentDetail.astro';
import Collection from '../components/Collection.astro';
export function getStaticPaths() {
  return publicPages(publication).map((page) => ({
    params: { path: page.path.slice(1, -1) },
    props: { page },
  }));
}
interface Props {
  page: PublicPage;
}
const { page } = Astro.props;
---

{
  page.kind === 'detail' ? (
    <ContentDetail content={page.content} publication={publication} />
  ) : (
    <Collection page={page} publication={publication} />
  )
}
