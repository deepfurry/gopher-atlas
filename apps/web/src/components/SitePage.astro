---
import Layout from '../layouts/Layout.astro';
import * as stylex from '@stylexjs/stylex';
import { layout as s } from '../styles/layout.stylex';
import { products as r } from '../styles/products.stylex';
import Home from './Home.astro';
import Articles from './Articles.astro';
import ProductDirectory from './ProductDirectory.astro';
import Search from './Search.astro';
import MarkdownBody from './MarkdownBody.astro';
import { words, localized, type Locale } from '../lib/i18n';
import { publication } from '../lib/publication/snapshot';
import aboutZh from '../content/chrome/about.zh.md?raw';
import aboutEn from '../content/chrome/about.en.md?raw';
import contributeZh from '../content/chrome/contribute.zh.md?raw';
import contributeEn from '../content/chrome/contribute.en.md?raw';
interface Props {
  page:
    | 'home'
    | 'articles'
    | 'topics'
    | 'notes'
    | 'about'
    | 'contribute'
    | 'search'
    | 'authors'
    | 'tags';
  locale?: Locale;
}
const { page, locale = 'zh' } = Astro.props,
  t = words[locale];
const body =
  page === 'about'
    ? locale === 'zh'
      ? aboutZh
      : aboutEn
    : locale === 'zh'
      ? contributeZh
      : contributeEn;
---

<Layout
  title={page === 'home' ? t.subtitle : t[page]}
  description={page === 'home'
    ? t.hero
    : page === 'authors'
      ? t.authorsIntro
      : page === 'tags'
        ? t.tagsIntro
        : page === 'articles'
          ? t.articlesIntro
          : page === 'topics'
            ? t.topicsIntro
            : page === 'notes'
              ? t.notesIntro
              : t[page]}
  locale={locale}
  home={page === 'home'}
  searchIndex={page === 'about' || page === 'contribute'}
>
  {
    page === 'home' ? (
      <Home locale={locale} publication={publication} />
    ) : page === 'articles' ? (
      <Articles publication={publication} locale={locale} />
    ) : page === 'topics' || page === 'notes' ? (
      <ProductDirectory kind={page} publication={publication} locale={locale} />
    ) : page === 'search' ? (
      <Search locale={locale} />
    ) : page === 'authors' || page === 'tags' ? (
      <section>
        <header {...stylex.attrs(s.pageHeading)}>
          <h1 {...stylex.attrs(s.title)}>
            {page === 'authors' ? t.authorsTitle : t.tagsTitle}
          </h1>
          <p class="lede">
            {page === 'authors' ? t.authorsIntro : t.tagsIntro}
          </p>
        </header>
        <ul
          class:list={[
            'directory-list',
            stylex.attrs(r.directory, page === 'tags' && r.tags).class,
          ]}
        >
          {page === 'authors'
            ? publication.authors.map((author) => (
                <li {...stylex.attrs(r.directoryItem, r.author)}>
                  <>
                    {author.avatarUrl && (
                      <img
                        class="avatar"
                        src={author.avatarUrl}
                        alt=""
                        width="56"
                        height="56"
                        loading="lazy"
                        referrerpolicy="no-referrer"
                      />
                    )}
                    <div {...stylex.attrs(r.groupHeader)}>
                      <h2 {...stylex.attrs(r.directoryTitle)}>
                        <a href={localized(`/authors/${author.slug}/`, locale)}>
                          {author.displayName}
                        </a>
                      </h2>
                      <p>
                        {publication.contentByAuthor.get(author.id)!.length}{' '}
                        {t.contentCount}
                      </p>
                    </div>
                  </>
                </li>
              ))
            : publication.tags.map((tag) => (
                <li {...stylex.attrs(r.directoryItem)}>
                  <>
                    <h2 {...stylex.attrs(r.directoryTitle)}>
                      <a href={localized(`/tags/${tag.slug}/`, locale)}>
                        {tag.name}
                      </a>
                    </h2>
                    <p>{tag.description}</p>
                    <span class="muted">
                      {publication.contentByTag.get(tag.id)!.length}{' '}
                      {t.contentCount}
                    </span>
                  </>
                </li>
              ))}
        </ul>
        {!(page === 'authors'
          ? publication.authors.length
          : publication.tags.length) && (
          <p class="empty">
            {t.noPublicContent}{' '}
            <a href={localized('/', locale)}>{t.otherReading}</a>
          </p>
        )}
      </section>
    ) : (
      <article class:list={['prose', stylex.attrs(s.prose).class]}>
        <>
          <span {...stylex.attrs(s.eyebrow)}>{page}</span>
          <h1>{t[page]}</h1>
          <MarkdownBody source={body} />
        </>
      </article>
    )
  }
</Layout>
