---
import Layout from '../layouts/Layout.astro';
---

<Layout title="搜索" description="搜索 GopherAtlas 的文章、笔记与知识专题。">
  <div class="prose" data-search>
    <h1>找到下一条线索。</h1>
    <p class="lede">搜索文章、工程笔记与专题中的关键词。</p>
    <form role="search">
      <label for="search-query">搜索关键词</label><div class="search-form">
        <input
          id="search-query"
          type="search"
          name="q"
          maxlength="200"
          autocomplete="off"
          placeholder="例如：并发、context、Go"
          aria-describedby="search-status"
        /><button type="submit">搜索</button>
      </div>
    </form>
    <p
      id="search-status"
      class="search-status"
      role="status"
      aria-live="polite"
    >
      输入关键词，搜索文章、笔记与专题。
    </p>
    <ol class="search-results" data-results aria-label="搜索结果"></ol>
    <button class="search-more" data-more hidden>加载更多结果</button>
    <noscript
      ><p>
        搜索需要 JavaScript。你也可以浏览<a href="/articles/">精选阅读</a>、<a
          href="/notes/">工程笔记</a
        >或<a href="/tags/">标签</a>。
      </p></noscript
    >
  </div>
</Layout>
<script>
  import { mountSearch } from '../lib/search';
  mountSearch(document.querySelector<HTMLElement>('[data-search]')!);
</script>
