---
import type { CuratedPayload } from '../lib/publication/types';
import { words, type Locale } from '../lib/i18n';
interface Props {
  payload: CuratedPayload;
  locale?: Locale;
}
const { payload: p, locale = 'zh' } = Astro.props,
  t = words[locale];
const labels =
  locale === 'zh'
    ? ['外部作者', '来源', '发布日期', '原文语言', '阅读难度', '评级']
    : [
        'Source author',
        'Source',
        'Published',
        'Source language',
        'Difficulty',
        'Rating',
      ];
const fields = [
  [labels[0], p.sourceAuthor],
  [labels[1], p.sourceName],
  [labels[2], p.sourcePublishedAt],
  [labels[3], p.sourceLanguage],
  [labels[4], p.difficulty ? t[p.difficulty] : ''],
  [labels[5], p.rating],
];
---

<aside
  class="source-meta"
  aria-label={locale === 'zh' ? '外部来源' : 'External source'}
>
  <h2>{t.read}</h2>
  <p class="source-links">
    <a href={p.sourceUrl} rel="noopener noreferrer">{p.sourceName || t.read}</a
    >{
      p.originalUrl && (
        <a href={p.originalUrl} rel="noopener noreferrer">
          {t.original}
        </a>
      )
    }{p.mustRead && <span class="label">{t.mustRead}</span>}
  </p>
  <dl>
    {
      fields
        .filter(([, value]) => value)
        .map(([label, value]) => (
          <div>
            <>
              <dt>{label}</dt>
              <dd>{value}</dd>
            </>
          </div>
        ))
    }
  </dl>
  {
    p.relatedLinks.length > 0 && (
      <>
        <>
          <h3>{t.related}</h3>
          <ul>
            {p.relatedLinks.map((link) => (
              <li>
                <a href={link.url} rel="noopener noreferrer">
                  {link.label}
                </a>
              </li>
            ))}
          </ul>
        </>
      </>
    )
  }
</aside>
