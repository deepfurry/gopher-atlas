---
import Layout from '../layouts/Layout.astro';
import snapshot from '../../../../tests/fixtures/snapshots/bootstrap.json';
const sections = [
  ['01', '精选阅读', '值得反复阅读的文章，以及推荐它们的理由。'],
  ['02', '原创文章', '从具体问题出发，理解 Go 的设计与实践。'],
  ['03', '工程笔记', '记录实验、排查与学习中逐渐清晰的认识。'],
  ['04', '知识专题', '把零散的知识连接成有序的阅读路径。'],
];
---

<Layout title="Go 知识地图">
  <p class="eyebrow">GopherAtlas / Go knowledge atlas</p>
  <h1>探索 Go，<br />连接知识与实践。</h1>
  <p class="lede">
    一份持续生长的技术刊物与知识地图。精选阅读、原创文章、工程笔记与知识专题，在这里相互连接。
  </p>
  <ol class="index" aria-label="内容方向">
    {
      sections.map(([number, title, description]) => (
        <li>
          <>
            <span class="meta">{number}</span>
            <strong>{title}</strong>
            <p>{description}</p>
          </>
        </li>
      ))
    }
  </ol>
  <p class="meta">平台筹备中 · 当前收录 {snapshot.content.length} 篇内容</p>
</Layout>
