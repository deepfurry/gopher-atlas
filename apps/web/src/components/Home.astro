---
import {
  editorialView,
  contentPath,
  hasEnglish,
} from '../lib/publication/editorial';
import { taxonomyText } from '../lib/publication/taxonomy';
import * as stylex from '@stylexjs/stylex';
import { layout as s } from '../styles/layout.stylex';
import { home as h } from '../styles/home.stylex';
import { products as r } from '../styles/products.stylex';
import { words, localized, displayDate, type Locale } from '../lib/i18n';
import { type Publication } from '../lib/publication/indexes';
import { homeContent } from '../lib/publication/home';
import CuratedCard from './CuratedCard.astro';
import Icon from './Icon.astro';
interface Props {
  locale?: Locale;
  publication: Publication;
}
const { locale = 'zh', publication: p } = Astro.props,
  t = words[locale];
const { notes, articles, topics: originalTopics } = homeContent(p);
const topics = originalTopics.map((item) => editorialView(item, locale));
---

<section class:list={['home-hero', stylex.attrs(h.hero).class]}>
  <div {...stylex.attrs(h.artwork)}>
    <img
      {...stylex.attrs(h.image)}
      src="/images/background.avif"
      width="1920"
      height="1080"
      alt="There's no place like 127.0.0.1"
      fetchpriority="high"
      decoding="async"
      draggable="false"
    />
  </div>
  <div {...stylex.attrs(s.shell, h.copyRow)}>
    <div {...stylex.attrs(h.copy)} data-hero-copy>
      <p {...stylex.attrs(h.label)} data-hero-eyebrow>
        DEEPFURRY / GO KNOWLEDGE ATLAS
      </p>
      <h1 {...stylex.attrs(h.title)} data-hero-title>
        {
          locale === 'zh'
            ? '代码之内，自有旷野。'
            : 'Within the code, the wild remains.'
        }
      </h1>
      <p {...stylex.attrs(h.subtitle)} data-hero-subtitle>
        {
          locale === 'zh'
            ? '我们试着理解世界，也不愿停止想象。'
            : 'We try to understand the world, yet never stop imagining.'
        }
      </p>
      <div {...stylex.attrs(h.actions)} data-hero-actions>
        <a
          class="inline-link corner-link"
          href={localized('/articles/', locale)}
          >{locale === 'zh' ? '探索文章' : 'Explore articles'}
          <span class="corner-brackets" aria-hidden="true"></span>
          <Icon name="arrowUpRight" /></a
        >
        <a class="inline-link corner-link" href={localized('/notes/', locale)}
          >{t.notes}<span class="corner-brackets" aria-hidden="true"></span>
          <Icon name="arrowRight" /></a
        >
      </div>
    </div>
    <a {...stylex.attrs(h.scroll)} href="#field-notes" data-hero-scroll
      >SCROLL TO EXPLORE <Icon name="arrowDown" /></a
    >
  </div>
</section>
<div class:list={['home-feed', stylex.attrs(s.shell, h.feed).class]}>
  <section
    id="field-notes"
    data-home-section="notes"
    {...stylex.attrs(s.editorial, h.section)}
  >
    <header>
      <p {...stylex.attrs(s.eyebrow)}>01 / FIELD NOTES</p>
      <h2 {...stylex.attrs(s.sectionTitle)}>{t.notes}</h2>
      <p {...stylex.attrs(s.description)}>
        {
          locale === 'zh'
            ? '团队原创，实践与思考。'
            : 'Original work. Practice and reflection.'
        }
      </p>
    </header>
    <div>
      {
        notes.map((note, index) => (
          <article {...stylex.attrs(h.note)} lang={note.language}>
            {index === 0 && (
              <p {...stylex.attrs(s.eyebrow)}>LATEST PUBLICATION</p>
            )}
            <h3 {...stylex.attrs(h.noteTitle, index === 0 && h.leadTitle)}>
              <a href={localized(note.canonicalPath, locale)}>{note.title}</a>
            </h3>
            {index === 0 && note.summary && (
              <p {...stylex.attrs(r.summary)}>{note.summary}</p>
            )}
            <div {...stylex.attrs(h.meta)}>
              <a
                href={localized(
                  '/authors/' + p.authorById.get(note.authorId)!.slug + '/',
                  locale,
                )}
              >
                {p.authorById.get(note.authorId)!.displayName}
              </a>
              <a
                href={localized(
                  '/notes/' + note.payload.groupSlug + '/',
                  locale,
                )}
              >
                {
                  taxonomyText(
                    p.notesByGroup.get(note.payload.groupSlug)!,
                    locale,
                  ).name
                }
              </a>
              <time datetime={new Date(note.lastPublishedAt).toISOString()}>
                {displayDate(note.lastPublishedAt, locale)}
              </time>
            </div>
          </article>
        ))
      }
      {!notes.length && <p class="empty">{t.noPublicContent}</p>}
      <a {...stylex.attrs(h.allLink)} href={localized('/notes/', locale)}
        >{locale === 'zh' ? '查看全部随笔' : 'All learning notes'}
        <Icon name="arrowRight" /></a
      >
    </div>
  </section>
  <section
    data-home-section="articles"
    {...stylex.attrs(s.editorial, h.section)}
  >
    <header>
      <p {...stylex.attrs(s.eyebrow)}>02 / CURATED</p>
      <h2 {...stylex.attrs(s.sectionTitle)}>
        {locale === 'zh' ? '精选文章' : 'Curated articles'}
      </h2>
      <p {...stylex.attrs(s.description)}>
        {
          locale === 'zh'
            ? '值得反复阅读。'
            : 'Worth reading. Worth revisiting.'
        }
      </p>
    </header>
    <div>
      {
        articles.map((item) => (
          <CuratedCard
            heading="h3"
            item={item}
            publication={p}
            locale={locale}
          />
        ))
      }
      {!articles.length && <p class="empty">{t.noPublicContent}</p>}
      <a {...stylex.attrs(h.allLink)} href={localized('/articles/', locale)}
        >{t.browse} <Icon name="arrowRight" /></a
      >
    </div>
  </section>
  {
    topics.length > 0 && (
      <section
        data-home-section="topics"
        {...stylex.attrs(s.editorial, h.section)}
      >
        <header>
          <p {...stylex.attrs(s.eyebrow)}>03 / TOPICS</p>
          <h2 {...stylex.attrs(s.sectionTitle)}>{t.topics}</h2>
          <p {...stylex.attrs(s.description)}>
            {locale === 'zh'
              ? '沿着一个主题，持续深入。'
              : 'Follow a subject. Go deeper.'}
          </p>
        </header>
        <div>
          {topics.map((topic) => (
            <article {...stylex.attrs(h.note)}>
              <h3 {...stylex.attrs(h.noteTitle)}>
                <a class="inline-link" href={contentPath(topic, locale)}>
                  {topic.title} <Icon name="arrowUpRight" />
                </a>
              </h3>
              <p {...stylex.attrs(r.summary)} lang={topic.language}>
                {topic.summary}
              </p>
              {locale === 'en' && !hasEnglish(topic) && (
                <p class="small-meta">Original language: {topic.language}</p>
              )}
              <p {...stylex.attrs(h.meta)}>
                {topic.topicEntries.length} {t.articleCount}
              </p>
            </article>
          ))}
          <a {...stylex.attrs(h.allLink)} href={localized('/topics/', locale)}>
            {t.enterTopics} <Icon name="arrowRight" />
          </a>
        </div>
      </section>
    )
  }
</div>
