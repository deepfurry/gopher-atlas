---
import MarkdownBody from './MarkdownBody.astro';
import CuratedCard from './CuratedCard.astro';
import PageHero from './PageHero.astro';
import type { Content } from '../lib/publication/types';
import type { Publication } from '../lib/publication/indexes';
interface Props {
  item: Extract<Content, { type: 'topic' }>;
  publication: Publication;
  entries?: { position: number; title: string; content?: Content }[];
}
const { item, publication: p, entries: previewEntries } = Astro.props;
const entries = previewEntries ?? p.topicTargets.get(item.id) ?? [];
const recommended = entries.slice(0, item.payload.recommendedCount);
---

<PageHero label="Topic" title={item.title} description={item.summary}
  ><a class="btn primary" href={`/articles/?topic=${item.slug}`}>在文章页查看</a
  ><button data-copy-link>复制专区链接</button></PageHero
>
<div class="topic-layout">
  <article class="panel content-detail" lang={item.language}>
    <h2 class="panel-heading">专区导读</h2><MarkdownBody
      source={item.bodyMarkdown}
    />
  </article>
  {
    recommended.length > 0 && (
      <aside class="panel" data-paged="2">
        <>
          <div class="panel-heading">
            <h2>推荐阅读 · {recommended.length}</h2>
            {recommended.length > 2 && (
              <div class="paged-controls">
                <button data-prev>上一页</button>
                <span data-page-label />
                <button data-next>下一页</button>
              </div>
            )}
          </div>
          <div class="reading-links">
            {recommended.map((entry) => (
              <div data-page-item>
                {entry.content?.type === 'curated_article' ? (
                  <a
                    class="reading-link"
                    href={entry.content.payload.sourceUrl}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <strong>{entry.content.title}</strong>
                    <small>
                      {entry.content.payload.rating} ·{' '}
                      {entry.content.payload.sourceLanguage} ·{' '}
                      {entry.content.payload.sourceAuthor} ·{' '}
                      {entry.content.payload.sourceName}
                    </small>
                  </a>
                ) : (
                  <p class="notice">
                    {'title' in entry ? entry.title : '未发布条目'} ·
                    本地快照中尚未发布
                  </p>
                )}
              </div>
            ))}
          </div>
        </>
      </aside>
    )
  }
</div>
<section class="topic-entries">
  <div class="section-intro">
    <span class="eyebrow">专题文章</span><h2>{entries.length} 篇精选文章</h2>
  </div>{
    entries.map((entry) =>
      entry.content?.type === 'curated_article' ? (
        <CuratedCard item={entry.content} publication={p} />
      ) : (
        <p class="notice">
          {'title' in entry ? entry.title : '未发布条目'} · 本地快照中尚未发布
        </p>
      ),
    )
  }
</section>
