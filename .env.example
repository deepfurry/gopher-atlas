# Local development. Process environment takes precedence over make dev-cms .env loading.
APP_ENV=development
CMS_LISTEN_ADDR=127.0.0.1:46217
CMS_BASE_URL=http://127.0.0.1:5173
PUBLIC_SITE_URL=https://gopheratlas.com
DATABASE_PATH=./data/gopheratlas.db

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Local OAuth example: http://127.0.0.1:5173/api/auth/github/callback
# Production: https://blog.go-furry.com/api/auth/github/callback
GITHUB_OAUTH_REDIRECT_URI=
BOOTSTRAP_ADMIN_GITHUB_ID=

SESSION_TTL=168h
OAUTH_STATE_TTL=10m

# Reserved for later phases; not consumed by the P0-1 CMS.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ASSETS_BUCKET=gopheratlas-assets
R2_CONTENT_BUCKET=gopheratlas-content
R2_ASSETS_PUBLIC_URL=https://assets.gopheratlas.com
CLOUDFLARE_DEPLOY_HOOK_URL=

LOG_LEVEL=info
LOG_FILE=./logs/cms.jsonl
LOG_MAX_SIZE_MB=100
LOG_MAX_BACKUPS=10
LOG_MAX_AGE_DAYS=30
LOG_COMPRESS=true
