---
import * as stylex from '@stylexjs/stylex';
import { layout as s } from '../styles/layout.stylex';
import { products as r } from '../styles/products.stylex';
import { displayDate, words, localized, type Locale } from '../lib/i18n';
import { type Publication } from '../lib/publication/indexes';
import Icon from './Icon.astro';
interface Props {
  group: Publication['groups'][number];
  publication: Publication;
  locale: Locale;
  order?: number;
}
const { group, publication: p, locale, order = 0 } = Astro.props,
  t = words[locale];
---

<article
  class:list={['note-group', stylex.attrs(s.editorial, r.group).class]}
  data-paged="4"
>
  <header {...stylex.attrs(r.groupHeader)}>
    <p {...stylex.attrs(s.eyebrow)}>
      {String(order + 1).padStart(2, '0')} / COLLECTION
    </p>
    <h2 {...stylex.attrs(s.sectionTitle)}>
      <a href={localized('/notes/' + group.slug + '/', locale)}>{group.name}</a>
    </h2>
    <p {...stylex.attrs(s.description)}>{group.description}</p>
    <p {...stylex.attrs(r.meta)}>{group.content.length} {t.noteCount}</p>
  </header>
  <div>
    {
      group.content.map((note) => (
        <a
          {...stylex.attrs(r.readingLink)}
          href={localized(note.canonicalPath, locale)}
          data-page-item
          lang={note.language}
        >
          <strong {...stylex.attrs(r.readingTitle)}>{note.title}</strong>
          <span {...stylex.attrs(r.meta)}>
            {displayDate(note.firstPublishedAt, locale)} /{' '}
            {p.authorById.get(note.authorId)!.displayName}
          </span>
        </a>
      ))
    }
    {
      group.content.length > 4 && (
        <div {...stylex.attrs(r.controls)}>
          <>
            <button data-prev>{t.previous}</button>
            <span data-page-label />
            <button data-next>{t.next}</button>
          </>
        </div>
      )
    }
    <a
      {...stylex.attrs(s.textLink)}
      href={localized('/notes/' + group.slug + '/', locale)}
      >{locale === 'zh' ? '全部组内文章' : 'All notes in this collection'}
      <Icon name="arrowRight" /></a
    >
  </div>
</article>
