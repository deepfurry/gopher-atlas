---
import Layout from '../layouts/Layout.astro';
import { publication as p } from '../lib/publication/snapshot';
---

<Layout
  title="作者"
  description="认识 GopherAtlas 的作者，阅读他们的文章、笔记与推荐。"
>
  <header class="page-heading">
    <h1>共同绘制知识地图</h1><p class="lede">
      认识在这里分享理解、经验与阅读发现的作者。
    </p>
  </header>
  <ul class="directory">
    {
      p.authors.map((author) => (
        <li>
          {author.avatarUrl && (
            <img
              class="avatar"
              src={author.avatarUrl}
              alt=""
              width="56"
              height="56"
              loading="lazy"
              referrerpolicy="no-referrer"
            />
          )}
          <h2>
            <a href={`/authors/${author.slug}/`}>{author.displayName}</a>
          </h2>
          <p>{p.contentByAuthor.get(author.id)!.length} 篇内容</p>
        </li>
      ))
    }
  </ul>
  {
    !p.authors.length && (
      <p class="empty">
        作者的公开作品将在这里汇集。<a href="/contribute/">了解内容贡献</a>。
      </p>
    )
  }
</Layout>
