---
interface Props {
  label: string;
  title: string;
  description: string;
}
const { label, title, description } = Astro.props;
---

<header class="page-hero">
  <div>
    <span class="eyebrow">{label}</span><h1>{title}</h1><p>{description}</p>
  </div><div class="hero-actions"><slot /></div>
</header>
