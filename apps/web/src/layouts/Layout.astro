---
import '../styles/global.css';
import * as stylex from '@stylexjs/stylex';
import { layout as s } from '../styles/layout.stylex';
import Icon from '../components/Icon.astro';
import ScrollDock from '../components/ScrollDock.astro';
import { copyrightYears } from '../lib/copyright';
import {
  words,
  localeOf,
  alternateChrome,
  chromePaths,
  withoutLocale,
  type Locale,
} from '../lib/i18n';
interface Props {
  editorialAlternates?: string;
  languageHref?: string;
  title: string;
  description?: string;
  canonical?: string;
  lang?: string;
  locale?: Locale;
  image?: string;
  imageAlt?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageType?: string;
  ogType?: 'website' | 'article';
  searchIndex?: boolean;
  noindex?: boolean;
  home?: boolean;
}
const {
  title,
  editorialAlternates,
  languageHref,
  description: descriptionProp,
  canonical: path = chromePaths.includes(withoutLocale(Astro.url.pathname))
    ? Astro.url.pathname
    : withoutLocale(Astro.url.pathname),
  locale = localeOf(Astro.url.pathname),
  lang = locale === 'zh' ? 'zh-CN' : 'en',
  image,
  imageAlt = '',
  imageWidth,
  imageHeight,
  imageType,
  ogType = 'website',
  searchIndex = false,
  noindex = false,
  home = false,
} = Astro.props;
const t = words[locale],
  canonical = new URL(path, Astro.site);
const description =
  descriptionProp ??
  (locale === 'zh'
    ? '原创学习随笔、Go 技术精选与话题阅读路径。'
    : 'Original learning notes, curated Go articles and topic reading paths.');
const socialImage = {
  url: new URL(image || '/images/og-default.png', Astro.site).href,
  alt: image
    ? imageAlt || title
    : locale === 'zh'
      ? 'GopherAtlas — 代码之内，自有旷野。'
      : 'GopherAtlas — Within the code, the wild remains.',
  width: image ? imageWidth : 1200,
  height: image ? imageHeight : 630,
  type: image ? imageType : 'image/png',
};
const base = withoutLocale(Astro.url.pathname);
const links = [
  ['/articles/', locale === 'zh' ? '文章' : 'Articles'],
  ['/topics/', locale === 'zh' ? '话题' : 'Topics'],
  ['/notes/', locale === 'zh' ? '随笔' : 'Notes'],
  ['/search/', t.search],
];
const localized = (href: string) => (locale === 'en' ? `/en${href}` : href);
const github = 'https://github.com/deepfurry/gopher-atlas';
const year = new Date().getFullYear();
---

<!doctype html>
<html lang={lang} data-locale={locale} data-theme="dark">
  <head>
    <style is:inline>
      @layer base, priority1, priority2, priority3, priority4, priority5;
    </style>
    <meta charset="utf-8" /><meta
      name="viewport"
      content="width=device-width, initial-scale=1"
    />
    <meta name="description" content={description} /><title>
      {title} · GopherAtlas
    </title>
    <link rel="canonical" href={canonical} />
    {
      (chromePaths.includes(base) || editorialAlternates) && (
        <>
          <>
            <link
              rel="alternate"
              hreflang="zh-CN"
              href={new URL(editorialAlternates || base, Astro.site)}
            />
            <link
              rel="alternate"
              hreflang="en"
              href={new URL(`/en${editorialAlternates || base}`, Astro.site)}
            />
            <link
              rel="alternate"
              hreflang="x-default"
              href={new URL(editorialAlternates || base, Astro.site)}
            />
          </>
        </>
      )
    }
    <meta property="og:title" content={title} /><meta
      property="og:description"
      content={description}
    /><meta property="og:url" content={canonical} /><meta
      property="og:type"
      content={ogType}
    /><meta property="og:site_name" content="GopherAtlas" />
    <meta property="og:locale" content={locale === 'zh' ? 'zh_CN' : 'en_US'} />
    {
      (chromePaths.includes(base) || editorialAlternates) && (
        <meta
          property="og:locale:alternate"
          content={locale === 'zh' ? 'en_US' : 'zh_CN'}
        />
      )
    }
    <meta property="og:image" content={socialImage.url} />
    <meta property="og:image:alt" content={socialImage.alt} />
    {
      socialImage.width && (
        <meta property="og:image:width" content={String(socialImage.width)} />
      )
    }
    {
      socialImage.height && (
        <meta property="og:image:height" content={String(socialImage.height)} />
      )
    }
    {
      socialImage.type && (
        <meta property="og:image:type" content={socialImage.type} />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage.url} />
    <meta name="twitter:image:alt" content={socialImage.alt} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    {
      home && (
        <link
          rel="preload"
          as="image"
          href="/images/background.avif"
          type="image/avif"
        />
      )
    }
    {
      import.meta.env.DEV && (
        <link rel="stylesheet" href="/virtual:stylex.css" />
      )
    }
    <link
      rel="alternate"
      type="application/rss+xml"
      title="GopherAtlas"
      href="/rss.xml"
    />
    <script is:inline>
      try {
        document.documentElement.dataset.theme =
          localStorage.getItem('gopheratlas-theme') === 'light'
            ? 'light'
            : 'dark';
      } catch {
        /* Optional theme preference. */
      }
    </script>
  </head>
  <body class:list={{ 'home-page': home }}>
    <a class="skip-link" href="#main">{t.skip}</a>
    <header class:list={['site-header', stylex.attrs(s.header).class]}>
      <div
        class:list={[
          'header-inner',
          stylex.attrs(s.shell, s.headerInner).class,
        ]}
      >
        <a
          class:list={['brand', stylex.attrs(s.brand).class]}
          href={localized('/')}>GopherAtlas</a
        >
        <div {...stylex.attrs(s.mobileControls)} data-header-mobile>
          <a
            {...stylex.attrs(s.iconButton)}
            href={localized('/search/')}
            aria-label={t.search}><Icon name="search" /></a
          >
          <button
            {...stylex.attrs(s.iconButton)}
            data-menu-toggle
            aria-expanded="false"
            aria-controls="primary-navigation"
            aria-label={t.menu}><Icon name="menu" /></button
          >
        </div>
        <nav
          id="primary-navigation"
          {...stylex.attrs(s.nav)}
          aria-label={locale === 'zh' ? '主导航' : 'Main navigation'}
        >
          {
            links.map(([href, label]) => (
              <a
                class="corner-link"
                href={localized(href)}
                aria-current={base.startsWith(href) ? 'page' : undefined}
              >
                {label}
                <span class="corner-brackets" aria-hidden="true" />
              </a>
            ))
          }
          <a
            class="inline-link corner-trigger"
            href={github}
            target="_blank"
            rel="noopener noreferrer"
            ><span class="corner-link"
              >GitHub<span class="corner-brackets" aria-hidden="true"
              ></span></span
            >
            <Icon name="arrowUpRight" /></a
          >
          <button
            class:list={[
              'theme-toggle',
              'corner-trigger',
              stylex.attrs(s.iconButton).class,
            ]}
            data-theme-toggle
            aria-label={t.theme}
            title={t.theme}
          >
            <span class="corner-link"
              ><span class="dark-icon"><Icon name="sun" /></span><span
                class="light-icon"><Icon name="moon" /></span
              ><span class="corner-brackets" aria-hidden="true"></span></span
            >
          </button>
          {
            !noindex && (
              <a
                class="corner-trigger language-toggle"
                data-language-link
                data-language-target={languageHref}
                href={
                  languageHref ||
                  alternateChrome(
                    Astro.url.pathname,
                    locale === 'zh' ? 'en' : 'zh',
                  )
                }
                lang={locale === 'zh' ? 'en' : 'zh-CN'}
              >
                <span class="corner-link">
                  {locale === 'zh' ? 'EN' : '中'}
                  <span class="corner-brackets" aria-hidden="true" />
                </span>
              </a>
            )
          }
        </nav>
      </div>
    </header>
    <main
      id="main"
      tabindex="-1"
      class:list={[
        'page-shell',
        stylex.attrs(home ? s.homeMain : s.shell, !home && s.main).class,
      ]}
      data-pagefind-body={searchIndex ? '' : undefined}
      data-pagefind-ignore={searchIndex ? undefined : 'all'}
    >
      <slot />
    </main>
    <footer class:list={['site-footer', stylex.attrs(s.footer).class]}>
      <div {...stylex.attrs(s.shell, s.footerInner)}>
        <p {...stylex.attrs(s.mono)}>
          © {copyrightYears(year)} DeepFurry &amp; LibreCosta
        </p>
        <nav
          {...stylex.attrs(s.footerLinks)}
          aria-label={locale === 'zh' ? '页脚导航' : 'Footer'}
        >
          <a href={github} target="_blank" rel="noopener noreferrer">GitHub</a>
          <a href={localized('/about/')}>{t.about}</a>
          <a href={localized('/contribute/')}>{t.contribute}</a>
          <a href={localized('/search/')}>{t.search}</a>
          <a href={localized('/legal/')}>{t.legal}</a>
          <a href={localized('/stats/')}>{t.stats}</a>
          <a href="/rss.xml">RSS</a>
        </nav>
      </div>
    </footer>
    <ScrollDock locale={locale} />
    <p class="public-toast" role="status" aria-live="polite" data-toast></p>
    <script>
      import { mountChrome } from '../lib/chrome';
      mountChrome();
      if (import.meta.env.DEV) import('virtual:stylex:css-only');
      import { mountMotion } from '../lib/motion';
      mountMotion();
    </script>
  </body>
</html>
