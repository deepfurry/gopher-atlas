---
import * as stylex from '@stylexjs/stylex';
import { products as s } from '../styles/products.stylex';
import { layout as l } from '../styles/layout.stylex';
import MarkdownBody from './MarkdownBody.astro';
import CuratedCard from './CuratedCard.astro';
import PageHero from './PageHero.astro';
import type { Content } from '../lib/publication/types';
import type { Publication } from '../lib/publication/indexes';
import { words, localized, type Locale } from '../lib/i18n';
interface Props {
  item: Extract<Content, { type: 'topic' }>;
  publication: Publication;
  entries?: { position: number; title: string; content?: Content }[];
  locale?: Locale;
}
const {
    item,
    publication: p,
    entries: previewEntries,
    locale = 'zh',
  } = Astro.props,
  t = words[locale];
const entries = previewEntries ?? p.topicTargets.get(item.id) ?? [];
---

<PageHero
  label="TOPIC / READING PATH"
  title={item.title}
  description={item.summary}
>
  <a
    {...stylex.attrs(l.textLink)}
    href={localized('/articles/?topic=' + item.slug, locale)}
    >{t.viewArticles}</a
  >
  <button data-copy-link>{t.copyTopic}</button>
</PageHero>
<article
  class:list={['content-detail', stylex.attrs(s.topicGuide).class]}
  lang={item.language}
>
  <MarkdownBody source={item.bodyMarkdown} />
</article>
<section class="topic-entries">
  <h2 {...stylex.attrs(l.sectionTitle)}>{t.readingOrder}</h2>
  <p {...stylex.attrs(s.meta)}>{entries.length} {t.articleCount}</p>
  <ol {...stylex.attrs(s.list)}>
    {
      entries.map((entry, order) => (
        <li
          {...stylex.attrs(s.readingEntry)}
          data-recommended={
            order < item.payload.recommendedCount ? 'true' : undefined
          }
        >
          <div {...stylex.attrs(s.entryNumber)}>
            {String(order + 1).padStart(2, '0')}
            {order < item.payload.recommendedCount && <p>{t.featured}</p>}
          </div>
          {entry.content?.type === 'curated_article' ? (
            <CuratedCard
              item={entry.content}
              publication={p}
              locale={locale}
              heading="h3"
            />
          ) : (
            <p class="notice">
              {'title' in entry ? entry.title : ''} / {t.unpublishedEntry}
            </p>
          )}
        </li>
      ))
    }
  </ol>
  {!entries.length && <p class="empty">{t.noPublicContent}</p>}
</section>
