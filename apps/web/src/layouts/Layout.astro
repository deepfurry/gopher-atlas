---
import '../styles/global.css';
interface Props {
  title: string;
  description?: string;
}
const {
  title,
  description = 'GopherAtlas：一份持续生长的 Go 技术刊物与知识地图。',
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · GopherAtlas</title>
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="GopherAtlas"
      href="/rss.xml"
    />
  </head>
  <body>
    <a class="skip-link" href="#main">跳至正文</a>
    <div class="shell">
      <header class="masthead">
        <a class="brand" href="/"
          >GopherAtlas<span class="text-accent"> /</span></a
        >
        <nav aria-label="主导航">
          <a href="/about/">关于</a><a href="/contribute/">参与贡献</a>
        </nav>
      </header>
      <main id="main" data-pagefind-body><slot /></main>
      <footer>
        <span>Technical Journal × Knowledge Atlas</span><a href="/rss.xml"
          >RSS 订阅</a
        >
      </footer>
    </div>
  </body>
</html>
