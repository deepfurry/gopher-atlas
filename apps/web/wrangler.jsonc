{
  "name": "gopheratlas-web",
  "main": "stats/worker/index.ts",
  "compatibility_date": "2026-09-10",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": ["/api/stats", "/api/stats/*"],
  },
  "d1_databases": [
    {
      "binding": "STATS_DB",
      "database_name": "gopheratlas-statistics",
      "database_id": "33474c53-2d09-4c1b-9545-2711f5f8bc2a",
      "migrations_dir": "stats/migrations",
    },
  ],
  "vars": {
    "RUM_ACCOUNT_ID": "f7cbff767a75ea1e28f0d4806258ae7e",
    "RUM_SITE_TAG": "03e6ff13e85744e9b5144069bcef41be",
    "RUM_GROUP_LIMIT": "100",
    "STATS_READ_ENABLED": "true",
    "STATS_SYNC_ENABLED": "true",
  },
  // Daily archive at 03:15 UTC.
  "triggers": { "crons": ["15 3 * * *"] },
}
