# make dev / make dev-web / make dev-cms read this root .env in Development.
# Existing process environment takes precedence, including explicit empty values.
# make dev starts CMS + Admin + Public. Public refresh restarts only Astro.
# Ctrl+C or an unexpected service exit stops the group.
# SQLite and storage persist across restarts. Run explicit make db-up once first.
# Local assets/content live beside DATABASE_PATH under storage/assets and storage/content.
APP_ENV=development
CMS_LISTEN_ADDR=127.0.0.1:46217
CMS_BASE_URL=http://127.0.0.1:5173
DATABASE_PATH=./data/gopheratlas.db

GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
# Local OAuth example: http://127.0.0.1:5173/api/auth/github/callback
# Production: https://<private-tailnet-host>.ts.net/api/auth/github/callback
GITHUB_OAUTH_REDIRECT_URI=
BOOTSTRAP_ADMIN_GITHUB_ID=

SESSION_TTL=168h
OAUTH_STATE_TTL=10m

# Production only: Development ignores these values and always uses local FileStore.
# Production requires all eight; Web builds use a separate read-only credential.
# Production buckets: gopheratlas-assets / gopheratlas-content; assets at https://assets.gopheratlas.com.
# PUBLIC_SITE_URL is the current Production Worker origin; DNS cutover is a separate P0-6 operation.
# Production CMS uses /srv/gopheratlas/config/cms.env through systemd EnvironmentFile.
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ASSETS_BUCKET=
R2_CONTENT_BUCKET=
R2_ASSETS_PUBLIC_URL=
CLOUDFLARE_DEPLOY_HOOK_URL=
PUBLIC_SITE_URL=

# Web content input. No PUBLIC_/VITE_ credentials.
# Production build input only. Development never reads R2 or uses these values.
# Production/Cloudflare build NEVER loads this file or falls back: provide separate RO credentials.
CONTENT_R2_ENDPOINT=
CONTENT_R2_BUCKET=
CONTENT_R2_ACCESS_KEY_ID=
CONTENT_R2_SECRET_ACCESS_KEY=
# Test/CI build input only. make dev and make dev-web reject a nonempty value.
# Normal development polls local storage/content/latest.json every 750 ms.
# No latest.json starts an empty site; first CMS publication fills it automatically.
CONTENT_SNAPSHOT_FILE=

LOG_LEVEL=info
LOG_FILE=./logs/cms.jsonl
LOG_MAX_SIZE_MB=100
LOG_MAX_BACKUPS=10
LOG_MAX_AGE_DAYS=30
LOG_COMPRESS=true
